{
  "name": "vanilla-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "eslint \"{src,public}/**/*.{tsx,jsx,ts,js}\" --fix",
    "update-all": "npx -p npm-check-updates ncu -u && npm install",
    "css:build": "lessc src/less.less src/less.css && tailwindcss src/less.css -o src/style.css --minify --watch"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.1",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-case-police": "^0.6.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-sonarjs": "^1.0.3",
    "postcss": "^8.4.31",
    "prettier": "^3.0.3",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.2",
    "terser": "^5.31.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "query-string": "^9.0.0"
  }
}
